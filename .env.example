# Copy this file to ".env" and edit the values.
PORT=5000

# MongoDB. Leave EMPTY to use a temporary in-memory database (data resets on restart).
# For real use: MongoDB Atlas link or mongodb://127.0.0.1:27017/youtube2
MONGO_URI=

JWT_SECRET=change-this-to-a-long-random-text

# Razorpay TEST keys (Razorpay dashboard -> Test Mode -> API Keys).
# Leave EMPTY to use DEMO payments (fake checkout) so you can still test the flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail SMTP for OTP + invoice emails (use a Gmail "App Password").
# Leave EMPTY and the OTP / invoice will be printed in the server console instead.
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=support@example.com

# Admin account created automatically on first start
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin@123

# Tunables
TRUSTED_DAYS=30
EDIT_WINDOW_MIN=15
COMPLETE_PERCENT=90
DOWNLOAD_DEDUP_MINUTES=60
ENFORCE_DEVICE_LIMIT=false
MAX_CALL_PARTICIPANTS=6

# Only needed if the frontend is hosted on a different domain (Netlify/Vercel).
# Comma separated, e.g. https://my-site.netlify.app
CLIENT_ORIGIN=
